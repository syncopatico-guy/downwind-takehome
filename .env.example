# ---------------------------------------------------------------------------
# Downwind — environment
# Copy to .env.local (gitignored) and fill in.
# ---------------------------------------------------------------------------

# Neon Postgres. Create a project at https://neon.tech and copy the pooled
# connection string. Must include ?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/downwind?sslmode=require

# OpenAQ v3 — free, instant. Register at https://explore.openaq.org
# The only feed giving a named physical monitoring station. v2 is retired (410).
OPENAQ_API_KEY=

# NASA FIRMS MAP_KEY — free, instant.
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
# ONLY needed to seed the September 2020 episode; the live 24h/48h/7d CSV
# feeds require no key at all.
FIRMS_MAP_KEY=

# Anthropic — the agent (needed from day 2).
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# NWS requires a self-identifying User-Agent (they reject generic clients).
NWS_USER_AGENT=(downwind, your-email@example.com)
